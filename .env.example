# Optional, for development only (npm run dev). Copy to .env. Never commit .env.
# The installed app keeps its API key in Settings instead.

# Overrides the key saved in Settings and locks that field.
ANTHROPIC_API_KEY=

# Model used for the fast admin parsing jobs.
AI_MODEL=claude-haiku-4-5

# Local user id for V1 single-user mode. Every row is scoped to it.
LOCAL_USER_ID=local

# Use another SQLite file instead of %APPDATA%\KanbanClass\kanbanclass.db, e.g. a test copy.
# DATABASE_URL=file:C:/path/to/test.db
