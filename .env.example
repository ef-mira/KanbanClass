# Copy to .env and fill in. Never commit .env.

# Optional. Without it, calendar parsing and action-item extraction fall back
# to built-in heuristics (no AI).
ANTHROPIC_API_KEY=

# Model used for the fast admin parsing jobs.
AI_MODEL=claude-haiku-4-5

# API server port (Vite proxies /api here in dev). Not PORT: tools often set that for the web server.
API_PORT=3001

# Local user id for V1 single-user mode. Every row is scoped to it.
LOCAL_USER_ID=local
