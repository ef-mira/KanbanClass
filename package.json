{
  "name": "kanbanclass",
  "productName": "KanbanClass",
  "version": "1.0.0",
  "description": "Desktop lesson planner: iCal timetable sync, subject Kanban, lesson folders on your computer.",
  "author": "KanbanClass",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/electron-build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migration": "node scripts/new-migration.mjs",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@prisma/client": "^6.19.3",
    "express": "^5.2.1",
    "node-ical": "^0.27.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.47.0",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "electron@44.4.5": true,
    "electron-winstaller@5.4.0": false
  },
  "private": true,
  "build": {
    "appId": "dk.kanbanclass.app",
    "productName": "KanbanClass",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "prisma/migrations/**/*",
      "prisma/schema.prisma",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "KanbanClass"
    },
    "extraResources": [
      {
        "from": "node_modules/.prisma/client",
        "to": "app/node_modules/.prisma/client",
        "filter": [
          "**/*",
          "!*.tmp*"
        ]
      }
    ]
  }
}
