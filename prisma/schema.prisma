// KanbanClass — local SQLite schema.
// Extends the V1 blueprint with: userId scoping on every root model (V2
// multi-tenant readiness), AI-parsed calendar fields, lesson types, homework
// posting state, per-user settings, and an AI parse cache.

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model UserSettings {
  userId           String   @id
  icalUrl          String?
  teachingRoot     String? // null = <home>/Documents/Teaching
  schoolYearStart  DateTime?
  schoolYearEnd    DateTime?
  hiddenEventTypes String   @default("[\"pause\"]") // JSON array of CalendarEvent.eventType
  lastSyncAt       DateTime?
  lastSyncSummary  String?
}

model Subject {
  id        String          @id @default(uuid())
  userId    String          @default("local")
  name      String // e.g. "Fysik 10", "Matematik 10A"
  color     String          @default("#3b82f6")
  isVisible Boolean         @default(true)
  lessons   Lesson[]
  events    CalendarEvent[]

  @@unique([userId, name])
}

model Lesson {
  id               String          @id @default(uuid())
  subjectId        String
  subject          Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sequenceOrder    Int
  title            String
  lessonType       String          @default("standard") // standard | lab | test | excursion | project
  bodyText         String          @default("")
  folderPath       String?
  homeworkText     String?
  homeworkOffset   Int? // Days before lesson to trigger reminder
  homeworkPostedAt DateTime?
  isPlanned        Boolean         @default(false)
  calendarEvents   CalendarEvent[]
  tasks            Task[]

  @@index([subjectId, sequenceOrder])
}

model CalendarEvent {
  id          String   @id @default(uuid())
  userId      String   @default("local")
  externalId  String // iCal UID (+ recurrence id); unique per user
  summary     String
  description String   @default("")
  location    String   @default("")
  startTime   DateTime
  endTime     DateTime
  // AI/heuristic parse results
  lessonType  String   @default("other") // kept for blueprint compatibility; mirrors eventType
  eventType   String   @default("other") // lesson | pause | meeting | supervision | other
  subjectName String?
  group       String?
  room        String?
  isPause     Boolean  @default(false)
  isIgnored   Boolean  @default(false) // manual per-event override
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@unique([userId, externalId])
  @@index([userId, startTime])
}

model Task {
  id              String   @id @default(uuid())
  userId          String   @default("local")
  title           String
  dueDate         DateTime
  isCompleted     Boolean  @default(false)
  isAutoGenerated Boolean  @default(false)
  lessonId        String?
  lesson          Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

// Timetable feeds repeat the same few summary strings hundreds of times.
// Caching parses by content hash keeps re-syncs from re-calling the model.
model EventParseCache {
  hash      String   @id
  result    String // JSON ParsedEventFields
  source    String // "ai" | "heuristic"
  createdAt DateTime @default(now())
}
